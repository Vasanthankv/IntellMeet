# Environment variables template for IntellMeet
# Copy this file to .env and fill in your actual values
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@intellmeet.tiylser.mongodb.net/intellmeet?retryWrites=true&w=majority&appName=Intellmeet
JWT_SECRET=your_jwt_secret_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key_optional

# Persistent Recording Storage Configuration
# Default is GRIDFS (uses MongoDB Atlas GridFS, surviving Render redeployments with 0 extra infrastructure)
STORAGE_TYPE=GRIDFS
# S3 Storage Configuration (Optional alternative to GridFS)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_s3_bucket_name
