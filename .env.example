# Environment variables template for IntellMeet
# Copy this file to .env and fill in your actual values
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@intellmeet.tiylser.mongodb.net/intellmeet?retryWrites=true&w=majority&appName=Intellmeet
JWT_SECRET=your_jwt_secret_key
GEMINI_API_KEY=your_gemini_api_key
